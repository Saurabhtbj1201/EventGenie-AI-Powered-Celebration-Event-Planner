{
  "name": "eventgenie",
  "version": "1.0.0",
  "description": "AI-powered Celebration & Event Planner — PromptWars Challenge 5",
  "main": "index.html",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "dev": "node server.js",
    "start": "node server.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "js/budget.js",
      "js/constants.js",
      "js/storage.js",
      "js/timeline.js",
      "js/ai.js",
      "api/generate.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  },
  "type": "module",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "keywords": ["event-planner", "ai", "gemini", "wedding", "birthday"],
  "author": "",
  "license": "MIT"
}
